{
  "name": "hemmacafe-pos",
  "private": true,
  "version": "2.2.0",
  "description": "Punto de venta de Hemma Café (React + Firestore offline + Electron para Windows 7)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicoquesoxd-Hemma/Hemma-Cafe.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --strictPort\" \"wait-on tcp:5173 && electron . --dev\"",
    "electron:build": "npm run build && electron-builder --win --ia32",
    "electron:build:x64": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.hemmacafe.pos",
    "productName": "Hemma POS",
    "directories": {
      "output": "dist_electron",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "artifactName": "Hemma-POS-Setup-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "icono.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nicoquesoxd-Hemma",
        "repo": "Hemma-Cafe"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.1.8",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "10.14.1",
    "lucide-react": "0.292.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "^8.2.2",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.20.5",
    "vitest": "2.1.9",
    "wait-on": "^7.2.0"
  }
}
